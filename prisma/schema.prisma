// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model NotificationLog {
  id               String   @id @default(cuid())
  shop             String   @db.VarChar(191)
  shopifyOrderId   String   @db.VarChar(191)
  orderNumber      String?
  customerName     String?
  customerPhone    String?
  notificationType String   @db.VarChar(191)
  status           String
  metaMessageId    String?
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shop, shopifyOrderId])
  @@unique([shop, shopifyOrderId, notificationType])
}

model AppSetting {
  id        String   @id @default(cuid())
  shop      String   @db.VarChar(191)
  key       String   @db.VarChar(191)
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, key])
  @@index([shop])
}

model CustomerOptIn {
  id         String   @id @default(cuid())
  shop       String   @db.VarChar(191)
  phone      String   @db.VarChar(191)
  country    String?
  name       String?
  optedIn    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([shop, phone])
  @@unique([shop, phone])
}
